rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Explicitly secure the erp collection
    match /erp/{docId} {
      allow read, write: if docId is string 
        && docId.size() <= 128 
        && docId.matches('^[a-zA-Z0-9_\\-]+$');
    }
  }
}
